# {$SITE_ADDRESS} is your domain (e.g. expensevision.net) — set it in the compose
# env. Caddy provisions and renews a Let's Encrypt certificate automatically.
{$SITE_ADDRESS} {
	encode gzip zstd

	# API → backend container
	handle /api/* {
		reverse_proxy backend:5000
	}

	# Everything else → the SPA (client-side routing falls back to index.html)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		# Sensible security headers for the static app shell
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
