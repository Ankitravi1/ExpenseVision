DATABASE_URL="file:./dev.db"
JWT_SECRET=change_me_generate_a_long_random_string_min_32_chars
PORT=5000
APP_URL=http://localhost:3000

# Optional: Google OAuth (login button hidden on frontend when unset)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: SMTP for verification/reset emails (users auto-verified when unset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Optional: Web push notifications (generate with node generate-keys.cjs)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Optional: comma-separated extra CORS origins
# CORS_ORIGINS=
