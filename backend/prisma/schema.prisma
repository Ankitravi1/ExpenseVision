generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String?  // Null for Google OAuth users
  name            String
  country         String?
  timezone        String   @default("UTC")
  currency        String?  // Null until profile completion
  theme           String?  @default("light")
  googleId        String?  @unique
  profilePicture  String?
  expoPushToken   String?
  role            String   @default("user")
  // Billing tier. Controls how much host-funded (platform-key) AI a user gets
  // per day. Users on their own key are unlimited and don't touch this.
  plan            String   @default("free") // free | pro

  // Auth fields
  emailVerified       Boolean   @default(false)
  verificationToken   String?
  resetPasswordToken  String?
  resetPasswordExpires DateTime?

  // 2FA fields
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?

  // Onboarding tracking
  onboardingStage     Int       @default(1)
  profileComplete     Boolean   @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  accounts        Account[]
  categories      Category[]
  transactions    Transaction[]
  budgets         Budget[]
  recurringRules  RecurringRule[]
  refreshTokens   RefreshToken[]
  pushSubscriptions PushSubscription[]
  aiSettings      AiSettings?
  notifications   Notification[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      String   // JSON string of { p256dh, auth }
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  replacedByToken String?
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String
  balance   Decimal  @default(0)
  initialBalance Decimal @default(0)
  color     String?
  icon      String?
  logo      String?
  frozen    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[] @relation("AccountTransactions")
  transferTransactions  Transaction[] @relation("TransferToAccount")
  recurringRules        RecurringRule[] @relation("RecurringAccount")
  recurringTransferRules RecurringRule[] @relation("RecurringTransferToAccount")
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   // 'income' | 'expense' | 'transfer'
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]
}

model Transaction {
  id                   String   @id @default(cuid())
  userId               String
  accountId            String
  transferToAccountId  String?
  categoryId           String?
  amount               Decimal
  type                 String   // 'income' | 'expense' | 'transfer'
  date                 String   // Stored as ISO date string (YYYY-MM-DD)
  note                 String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account   @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  transferToAccount Account?  @relation("TransferToAccount", fields: [transferToAccountId], references: [id], onDelete: SetNull)
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, categoryId, type])
}

model Budget {
  id             String   @id @default(cuid())
  userId         String
  categoryId     String
  amount         Decimal
  month          String   @default("")  // YYYY-MM format; "" = repeats every month
  rollover       Boolean  @default(false) // carry last month's leftover/overspend into this month
  alertThreshold Decimal  @default(100)   // percent of budget at which to send an alert
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
}

model RecurringRule {
  id                  String   @id @default(cuid())
  userId              String
  note                String
  amount              Decimal
  type                String   // 'income' | 'expense' | 'transfer'
  accountId           String
  transferToAccountId String?
  categoryId          String?
  frequency           String   // 'daily' | 'weekly' | 'monthly' | 'yearly'
  dayAnchor           Int      // day-of-month anchor for monthly/yearly (clamped to month length)
  nextRun             String   // YYYY-MM-DD of the next occurrence to create
  endDate             String?  // YYYY-MM-DD (inclusive); null = forever
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account   @relation("RecurringAccount", fields: [accountId], references: [id], onDelete: Cascade)
  transferToAccount Account?  @relation("RecurringTransferToAccount", fields: [transferToAccountId], references: [id], onDelete: Cascade)
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, active, nextRun])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, read])
}

model AiSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  enabled         Boolean  @default(false)
  importEnabled   Boolean  @default(true)
  autoParseEnabled Boolean @default(true)
  // When false (default) the user relies on the platform/host AI key; when true
  // they use their own provider/key configured below. Falls back to the other
  // source if the preferred one isn't available.
  useOwnKey       Boolean  @default(false)
  provider        String   @default("deepseek")
  model           String   @default("deepseek-v4-flash")
  baseUrl         String?
  keys            String?  // JSON string: { "openai": ["encryptedKey", ...], ... }
  customModels    String?  // JSON string: { "openai": ["model1", ...], ... }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Singleton (id = "platform") holding the host-provided AI config that users
// rely on by default. Only the superadmin can read/write it. Mirrors the
// per-user AiSettings shape (multi-provider) so the admin UI matches the user
// UI. Keys are encrypted with the same AES-256-GCM scheme as per-user keys.
model PlatformSettings {
  id             String   @id @default("platform")
  aiEnabled      Boolean  @default(false)
  aiProvider     String   @default("deepseek") // active provider
  aiModel        String   @default("")          // active model
  aiBaseUrl      String?  // JSON map: { provider: url }
  aiKeys         String?  // JSON map: { provider: ["encryptedKey", ...] }
  aiCustomModels String?  // JSON map: { provider: ["model", ...] }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Per-user, per-day AI usage counter for host-funded (platform-key) calls.
// Own-key usage is never counted. Used to enforce the free/pro daily caps.
model AiUsage {
  id      String @id @default(cuid())
  userId  String
  date    String // YYYY-MM-DD (server/UTC)
  feature String // 'autoparse' | 'import'
  count   Int    @default(0)

  @@unique([userId, date, feature])
  @@index([userId, date])
}
