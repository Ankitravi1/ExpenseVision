# Copy to backend/.env.prod on the server and fill in. NEVER commit the real file.
# Generate secrets with:  openssl rand -hex 32

NODE_ENV=production

# Must match the postgres service creds in docker-compose.prod.yml. Host is the
# compose service name `postgres`.
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB

# 32+ random bytes each. Losing AI_SETTINGS_SECRET makes stored AI keys undecryptable.
JWT_SECRET=
AI_SETTINGS_SECRET=

PORT=5000
APP_URL=https://your-domain.example

# Only these origins may call the API in production (your site). Comma-separated.
CORS_ORIGINS=https://your-domain.example

# Optional
# SUPERADMIN_EMAIL=you@example.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
